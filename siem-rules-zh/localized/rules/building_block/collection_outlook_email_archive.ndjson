{"author":["Elastic"],"building_block_type":"default","description":"检测构建块：访问Outlook数据文件。对应需求：数据收集。官方：Accessing Outlook Data Files。","from":"now-119m","index":["endgame-*","logs-endpoint.events.process-*","logs-system.security*","logs-windows.sysmon_operational-*","winlogbeat-*"],"interval":"60m","language":"eql","license":"Elastic License v2","name":"【默认】构建块：访问Outlook数据文件","risk_score":21,"rule_id":"2e311539-cd88-4a85-a301-04f38795007c","severity":"low","tags":["操作系统: Windows","主题: 数据收集","来源: 默认","对应需求: 数据收集"],"timestamp_override":"event.ingested","type":"eql","query":"process where host.os.type == \"windows\" and event.type == \"start\" and process.args : (\"*.ost\", \"*.pst\") and\n  not process.name : \"outlook.exe\" and\n  not (\n        process.name : \"rundll32.exe\" and\n        process.args : \"*davclnt.dll,DavSetCookie*\"\n  )\n","threat":[{"framework":"MITRE ATT&CK","technique":[{"id":"T1005","name":"Data from Local System","reference":"https://attack.mitre.org/techniques/T1005/"},{"id":"T1114","name":"Email Collection","reference":"https://attack.mitre.org/techniques/T1114/","subtechnique":[{"id":"T1114.001","name":"Local Email Collection","reference":"https://attack.mitre.org/techniques/T1114/001/"}]}],"tactic":{"id":"TA0009","name":"Collection","reference":"https://attack.mitre.org/tactics/TA0009/"}}],"false_positives":["合法变更窗口内的运维、发布或安全扫描"],"related_integrations":[{"package":"endpoint","version":"*"},{"package":"windows","version":"*"},{"package":"system","version":"*"}],"note":"## 调查指引\n\n### 规则说明\n构建块：访问Outlook数据文件\n\n### 为何重要\n收集邮箱、屏幕或敏感文件\n\n### 调查步骤\n1. 核对告警实体、进程/网络字段与时间窗。\n2. 核对是否符合变更窗口与已知业务工具。\n3. 关联同主机或同账号前后同类告警。\n\n### 常见误报\n- 合法变更窗口内的运维、发布或安全扫描\n\n### 响应建议\n1. 确认是否授权与变更窗口。\n2. 无授权则隔离相关主机或账号并排查落地与外连。\n3. 按主机与用户关联前后同类告警。\n","setup":"## 设置说明\n\n1. 按规则数据源接入对应日志（终端、云、身份或网络）。\n2. 构建块规则用于关联，确认数据流有数据后再评估。\n","investigation_fields":{"field_names":["@timestamp","host.name","user.name","cloud.account.id","process.name","process.command_line","file.path","source.ip","destination.ip","event.action","message"]},"version":110,"immutable":true,"rule_source":{"type":"external","is_customized":true,"customized_fields":[{"field_name":"name"},{"field_name":"description"},{"field_name":"note"},{"field_name":"setup"},{"field_name":"false_positives"},{"field_name":"tags"},{"field_name":"investigation_fields"}],"has_base_version":true},"actions":[],"exceptions_list":[],"risk_score_mapping":[],"severity_mapping":[],"required_fields":[],"output_index":"","revision":1,"enabled":true,"max_signals":100,"to":"now","references":[]}
