{"author":["Elastic"],"description":"检测Windows命令提示符可疑网络连接。对应需求：执行。官方：Suspicious Command Prompt Network Connection。","from":"now-9m","index":["winlogbeat-*","logs-endpoint.events.process-*","logs-endpoint.events.network-*","logs-windows.sysmon_operational-*","logs-sentinel_one_cloud_funnel.*"],"language":"eql","license":"Elastic License v2","name":"【默认】Windows命令提示符可疑网络连接","note":"## 调查指引\n\n### 规则说明\nWindows命令提示符可疑网络连接\n\n### 为何重要\n在主机上执行命令或脚本\n\n### 调查步骤\n1. 核对进程名、命令行、父进程、用户与事件ID。\n2. 核对路径、注册表、外连地址与是否符合变更窗口。\n3. 关联同主机前后同类告警、落地文件与凭据操作。\n\n### 常见误报\n- 合法变更窗口内的运维、软件分发或安全工具\n\n### 响应建议\n1. 确认是否授权与变更窗口。\n2. 无授权则隔离主机、终止可疑进程并排查落地文件与账号。\n3. 按主机与用户关联前后同类告警与外连。\n","setup":"## 设置说明\n\n1. 目标 Windows 主机安装 Elastic Agent，启用 **Elastic Defend**（按规则需要进程/网络/文件/注册表或安全日志）。\n2. 确认相关数据流有数据后再评估告警。\n","references":["https://www.iana.org/assignments/iana-ipv4-special-registry/iana-ipv4-special-registry.xhtml"],"risk_score":21,"rule_id":"89f9a4b0-9f8f-4ee0-8823-c4751a6d6696","severity":"low","tags":["操作系统: Windows","主题: 执行","来源: 默认","对应需求: 执行"],"type":"eql","query":"sequence by process.entity_id with maxspan=15s\n  [process where host.os.type == \"windows\" and event.type == \"start\" and\n    process.name : \"cmd.exe\" and process.args : (\"/c\", \"/k\") and\n    (\n      process.args : (\"*.bat\", \"*.cmd\") or\n      process.command_line : (\"*http://*\", \"*https://*\", \"*ftp://*\") or\n      process.parent.name : (\"excel.exe\", \"msaccess.exe\", \"mspub.exe\", \"powerpnt.exe\", \"winword.exe\", \"outlook.exe\")\n    )\n  ]\n  [network where host.os.type == \"windows\" and process.name : \"cmd.exe\" and\n     not cidrmatch(destination.ip, \"10.0.0.0/8\", \"127.0.0.0/8\", \"169.254.0.0/16\", \"172.16.0.0/12\", \"192.0.0.0/24\",\n                                  \"192.0.0.0/29\", \"192.0.0.8/32\", \"192.0.0.9/32\", \"192.0.0.10/32\", \"192.0.0.170/32\",\n                                  \"192.0.0.171/32\", \"192.0.2.0/24\", \"192.31.196.0/24\", \"192.52.193.0/24\",\n                                  \"192.168.0.0/16\", \"192.88.99.0/24\", \"224.0.0.0/4\", \"100.64.0.0/10\", \"192.175.48.0/24\",\n                                  \"198.18.0.0/15\", \"198.51.100.0/24\", \"203.0.113.0/24\", \"240.0.0.0/4\", \"::1\",\n                                  \"FE80::/10\", \"FF00::/8\")]\n","investigation_fields":{"field_names":["@timestamp","host.name","user.name","user.id","process.name","process.parent.name","process.executable","process.command_line","process.parent.executable","event.action","event.code","file.path","registry.path","source.ip","destination.ip","winlog.event_data.TargetUserName","message"]},"threat":[{"framework":"MITRE ATT&CK","technique":[{"id":"T1059","name":"Command and Scripting Interpreter","reference":"https://attack.mitre.org/techniques/T1059/","subtechnique":[{"id":"T1059.003","name":"Windows Command Shell","reference":"https://attack.mitre.org/techniques/T1059/003/"}]}],"tactic":{"id":"TA0002","name":"Execution","reference":"https://attack.mitre.org/tactics/TA0002/"}},{"framework":"MITRE ATT&CK","technique":[{"id":"T1071","name":"Application Layer Protocol","reference":"https://attack.mitre.org/techniques/T1071/"},{"id":"T1105","name":"Ingress Tool Transfer","reference":"https://attack.mitre.org/techniques/T1105/"}],"tactic":{"id":"TA0011","name":"Command and Control","reference":"https://attack.mitre.org/tactics/TA0011/"}}],"false_positives":["合法变更窗口内的运维、软件分发或安全工具"],"interval":"5m","related_integrations":[{"package":"endpoint","version":"*"},{"package":"windows","version":"*"},{"package":"sentinel_one_cloud_funnel","version":"*"}],"version":216,"immutable":true,"rule_source":{"type":"external","is_customized":true,"customized_fields":[{"field_name":"name"},{"field_name":"description"},{"field_name":"note"},{"field_name":"setup"},{"field_name":"false_positives"},{"field_name":"tags"},{"field_name":"investigation_fields"}],"has_base_version":true},"actions":[],"exceptions_list":[],"risk_score_mapping":[],"severity_mapping":[],"required_fields":[],"output_index":"","revision":1,"enabled":true,"max_signals":100,"to":"now"}
