{"id":"b27e072b-3aa0-4600-866a-f22b8119c7ef","rule_id":"c0429aa8-9974-42da-bfb6-53a0a515a145","name":"【默认】Windows组策略中新建或修改计划任务","immutable":true,"rule_source":{"type":"external","is_customized":true,"customized_fields":[{"field_name":"name"},{"field_name":"description"},{"field_name":"note"},{"field_name":"tags"},{"field_name":"false_positives"},{"field_name":"setup"},{"field_name":"investigation_fields"}],"has_base_version":true},"version":316,"revision":4,"updated_at":"2026-09-15T06:08:58.417Z","updated_by":"elastic","created_at":"2026-09-15T02:32:15.431Z","created_by":"elastic","enabled":true,"interval":"5m","from":"now-9m","to":"now","description":"检测 GPO 中创建/修改计划任务或服务。对应需求：GPO策略创建/修改/删除。","tags":["操作系统: Windows","主题: 身份安全","来源: 默认","对应需求: GPO"],"author":["Elastic"],"license":"Elastic License v2","threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0004","name":"Privilege Escalation","reference":"https://attack.mitre.org/tactics/TA0004/"},"technique":[{"id":"T1484","name":"Domain or Tenant Policy Modification","reference":"https://attack.mitre.org/techniques/T1484/","subtechnique":[{"id":"T1484.001","name":"Group Policy Modification","reference":"https://attack.mitre.org/techniques/T1484/001/"}]}]},{"framework":"MITRE ATT&CK","tactic":{"id":"TA0003","name":"Persistence","reference":"https://attack.mitre.org/tactics/TA0003/"},"technique":[{"id":"T1053","name":"Scheduled Task/Job","reference":"https://attack.mitre.org/techniques/T1053/","subtechnique":[{"id":"T1053.005","name":"Scheduled Task","reference":"https://attack.mitre.org/techniques/T1053/005/"}]},{"id":"T1543","name":"Create or Modify System Process","reference":"https://attack.mitre.org/techniques/T1543/","subtechnique":[{"id":"T1543.003","name":"Windows Service","reference":"https://attack.mitre.org/techniques/T1543/003/"}]}]}],"investigation_fields":{"field_names":["@timestamp","host.name","winlog.computer_name","user.name","user.id","source.ip","event.code","winlog.event_id","event.action","event.outcome","winlog.event_data.TargetUserName","winlog.event_data.SubjectUserName","winlog.event_data.MemberName","message","event.original"]},"related_integrations":[{"package":"endpoint","version":">=9.0.0"},{"package":"windows","version":">=3.0.0"},{"package":"m365_defender","version":">=5.0.0"},{"package":"sentinel_one_cloud_funnel","version":">=1.9.0"}],"required_fields":[{"name":"event.action","type":"keyword","ecs":true},{"name":"event.type","type":"keyword","ecs":true},{"name":"file.name","type":"keyword","ecs":true},{"name":"file.path","type":"keyword","ecs":true},{"name":"host.os.type","type":"keyword","ecs":true},{"name":"process.executable","type":"keyword","ecs":true}],"setup":"## 设置说明\n\n需要 Windows/域控安全日志（Winlogbeat 或 Agent Windows 集成）。部分规则依赖活动目录相关事件。\n","note":"## 调查指引\n\n请结合 Windows 安全事件字段：`user.name`、`source.ip`、`host.name`、`event.code`、`winlog.event_data.*`。\n\n### 响应建议\n1. 确认是否授权。\n2. 无授权则遏制账号并溯源。\n3. 关联同用户的登录失败、组变更、GPO 变更。\n","false_positives":["变更窗口内的合法管理操作","基线学习期的机器学习误报"],"references":[],"risk_score":21,"risk_score_mapping":[],"severity":"low","severity_mapping":[],"timestamp_override":"event.ingested","output_index":"","max_signals":100,"exceptions_list":[],"actions":[],"type":"eql","language":"eql","index":["winlogbeat-*","logs-endpoint.events.file-*","logs-windows.sysmon_operational-*","endgame-*","logs-m365_defender.event-*","logs-sentinel_one_cloud_funnel.*"],"query":"file where host.os.type == \"windows\" and event.type != \"deletion\" and event.action != \"open\" and\n file.name : (\"ScheduledTasks.xml\", \"Services.xml\") and\n  file.path : (\n    \"?:\\\\Windows\\\\SYSVOL\\\\domain\\\\Policies\\\\*\\\\MACHINE\\\\Preferences\\\\ScheduledTasks\\\\ScheduledTasks.xml\",\n    \"?:\\\\Windows\\\\SYSVOL\\\\domain\\\\Policies\\\\*\\\\MACHINE\\\\Preferences\\\\Services\\\\Services.xml\"\n  ) and\n  not process.executable : \"C:\\\\Windows\\\\System32\\\\dfsrs.exe\"\n"}
