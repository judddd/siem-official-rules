{"id":"d22d7a2f-12c8-4f73-bfcb-a3eca104ce7d","rule_id":"5b8d7b94-23c6-4e3f-baed-3a4d0da4f19d","name":"【默认】Linux异常用户首次登录成功","immutable":true,"rule_source":{"type":"external","is_customized":true,"customized_fields":[{"field_name":"name"},{"field_name":"description"},{"field_name":"note"},{"field_name":"tags"},{"field_name":"false_positives"},{"field_name":"setup"},{"field_name":"investigation_fields"}],"has_base_version":true},"version":6,"revision":8,"updated_at":"2026-09-15T06:08:55.918Z","updated_by":"elastic","created_at":"2026-09-07T03:13:31.332Z","created_by":"elastic","enabled":true,"interval":"5m","from":"now-9m","to":"now","description":"使用新词检测：在最近 5 天内未见过的用户首次远程登录成功。对应需求：登录审计 / 新建或异常账号使用。","tags":["操作系统: Linux","主题: 身份安全","来源: 默认","规则来源: 默认","用例: 身份与访问审计","对应需求: 登录审计"],"author":["Elastic"],"license":"Elastic License v2","threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0001","name":"Initial Access","reference":"https://attack.mitre.org/tactics/TA0001/"},"technique":[{"id":"T1078","name":"Valid Accounts","reference":"https://attack.mitre.org/techniques/T1078/"},{"id":"T1133","name":"External Remote Services","reference":"https://attack.mitre.org/techniques/T1133/"}]},{"framework":"MITRE ATT&CK","tactic":{"id":"TA0008","name":"Lateral Movement","reference":"https://attack.mitre.org/tactics/TA0008/"},"technique":[{"id":"T1021","name":"Remote Services","reference":"https://attack.mitre.org/techniques/T1021/","subtechnique":[{"id":"T1021.004","name":"SSH","reference":"https://attack.mitre.org/techniques/T1021/004/"}]}]}],"investigation_fields":{"field_names":["@timestamp","host.name","host.id","user.name","user.id","source.ip","source.port","event.action","event.outcome","event.category","message","event.original","related.user","related.ip","agent.id"]},"related_integrations":[{"package":"system","version":">=2.0.0"}],"required_fields":[{"name":"event.action","type":"keyword","ecs":true},{"name":"event.category","type":"keyword","ecs":true},{"name":"event.outcome","type":"keyword","ecs":true},{"name":"host.os.type","type":"keyword","ecs":true}],"setup":"## 设置说明\n\n1. 目标 主机安装 Elastic Agent，启用 **Elastic Defend** 与/或 **System** / **auditd**（按规则数据源）。\n2. 确认相关数据流有数据后再评估告警。\n3. 可用演示脚本做触发验证。\n","note":"## 调查指引\n\n### 规则说明\n新用户首次登录成功。\n\n### 为何重要\n可能是新建后门账号开始使用。\n\n### 调查步骤\n1. 确认账号是否经审批创建。\n2. 检查创建与加组时间线。\n3. 无备案则隔离。\n\n### 常见误报\n- 合法变更窗口内的运维操作\n\n### 响应建议\n1. 确认是否授权与变更窗口。\n2. 无授权则回滚变更、禁用相关账号并轮换凭证。\n3. 按主机与用户关联前后身份类告警。\n","false_positives":["新员工/新服务账号首次登录"],"references":[],"risk_score":21,"risk_score_mapping":[],"severity":"low","severity_mapping":[],"timestamp_override":"event.ingested","output_index":"","max_signals":100,"exceptions_list":[],"actions":[],"type":"new_terms","query":"event.category:authentication and host.os.type:linux and event.action:ssh_login and event.outcome:success\n","new_terms_fields":["related.user"],"history_window_start":"now-5d","index":["logs-system.auth-*","filebeat-*"],"language":"kuery"}
