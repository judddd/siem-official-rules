    "9e81b1fd-e9fb-49a7-8ebe-0d1a14090142": {
      "kind": "official_zh",
      "category": "linux",
      "stem": "credential_access_potential_password_spraying_attack",
      "official_relpath": "rules/linux/credential_access_potential_password_spraying_attack.toml",
      "official_snapshot": {
        "name": "Potential Password Spraying Attack via SSH",
        "updated_date": "2026/09/18",
        "maturity": "production",
        "content_hash": "d002e628df835e6e69186bcfec547aef8db511df56f9168f4d01a30652a51d87"
      },
      "query_override": "from logs-system.auth-* metadata _id, _index, _version\n\n// Create 5-minute time buckets\n| eval Esql.time_window_date_trunc = date_trunc(5 minutes, @timestamp)\n\n// Ensure event.action values in a list are expanded\n| mv_expand event.action \n\n| where\n  event.category == \"authentication\" and event.action in (\"ssh_login\", \"user_login\") and event.outcome == \"failure\" and\n  source.ip is not null \n\n| keep\n   @timestamp,\n   _id,\n   _index,\n   _version,\n   host.name,\n   host.id,\n   event.category,\n   event.action,\n   event.outcome,\n   source.ip,\n   process.name,\n   user.name,\n   message,\n   data_stream.dataset,\n   data_stream.namespace,\n   agent.id,\n   user.id,\n   Esql.time_window_date_trunc\n\n| stats\n  Esql.event_count = count(*),\n  Esql.user_name_count_distinct = count_distinct(user.name),\n  Esql.user_name_values = values(user.name),\n  Esql.host_name_values = values(host.name),\n  Esql.host_id_values = values(host.id),\n  Esql.agent_id_values = values(agent.id),\n  Esql.process_name_values = values(process.name),\n  Esql.message_values = values(message),\n  Esql.data_stream_dataset_values = values(data_stream.dataset),\n  Esql.data_stream_namespace_values = values(data_stream.namespace)\n  by Esql.time_window_date_trunc, source.ip\n\n| where Esql.user_name_count_distinct > 10 and Esql.event_count >= 30\n| eval host.name = MV_FIRST(Esql.host_name_values),\n       user.name = MV_FIRST(Esql.user_name_values),\n       agent.id = MV_FIRST(Esql.agent_id_values)\n| KEEP source.ip, host.name, user.name, agent.id, Esql.time_window_date_trunc, Esql.*\n",
      "localized_at": "2026-09-15T06:09:00.621Z",
      "source": "linux_windows_chinese_rule.ndjson",
      "rule_id": "9e81b1fd-e9fb-49a7-8ebe-0d1a14090142"
    },
