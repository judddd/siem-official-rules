    "835c0622-114e-40b5-a346-f843ea5d01f1": {
      "kind": "official_zh",
      "category": "linux",
      "stem": "credential_access_potential_linux_local_account_bruteforce",
      "official_relpath": "rules/linux/credential_access_potential_linux_local_account_bruteforce.toml",
      "official_snapshot": {
        "name": "Potential Linux Local Account Brute Force Detected",
        "updated_date": "2026/09/18",
        "maturity": "production",
        "content_hash": "6f22cbc037095f8609b8ccb349ed7fe50eb2a459ee10c02bc978ae05588ee522"
      },
      "query_override": "from logs-endpoint.events.process* metadata _id, _index, _version\n\n// Create 1-minute time buckets\n| eval Esql.time_window_date_trunc = date_trunc(1 minute, @timestamp)\n\n// Ensure event.action values in a list are expanded\n| mv_expand event.action \n\n| where\n  event.category == \"process\" and event.type == \"start\" and event.action == \"exec\" and process.name == \"su\" and \n  process.parent.name not in (\n    \"bash\", \"dash\", \"ash\", \"sh\", \"tcsh\", \"csh\", \"zsh\", \"ksh\", \"fish\", \"clickhouse-server\", \"ma\", \"gitlab-runner\",\n    \"updatedb.findutils\", \"cron\", \"perl\", \"sudo\", \"java\", \"cloud-app-identify\", \"ambari-sudo.sh\", \"runc\",\n    \"cau9sat.exe\", \"git-pull.sh\", \"distributor-pulltabs-devel-live\", \"p_ctmag\", \"backup_agent_main\", \"sshd\",\n    \"nxpgsql\", \"cau9cli.exe\", \"autopostgresqlbackup\"\n  ) and\n  not process.parent.command_line == \"runc init\"\n\n| keep\n   @timestamp,\n   host.name,\n   event.action,\n   event.category,\n   event.type,\n   process.name,\n   process.parent.name,\n   process.parent.command_line,\n   process.command_line,\n   user.name,\n   data_stream.dataset,\n   data_stream.namespace,\n   process.parent.executable,\n   agent.id,\n   user.id,\n   Esql.time_window_date_trunc\n\n| stats\n  Esql.event_count = count(*),\n  Esql.process_command_line_values = values(process.command_line),\n  Esql.process_parent_command_line_values = values(process.parent.command_line),\n  Esql.process_parent_name_values = values(process.parent.name),\n  Esql.user_name_values = values(user.name),\n  Esql.host_name_values = values(host.name),\n  Esql.data_stream_dataset_values = values(data_stream.dataset),\n  Esql.data_stream_namespace_values = values(data_stream.namespace)\n  by process.parent.executable, agent.id, user.id, Esql.time_window_date_trunc\n\n| where Esql.event_count >= 10\n| eval host.name = MV_FIRST(Esql.host_name_values),\n       user.name = MV_FIRST(Esql.user_name_values),\n       process.name = \"su\",\n       process.parent.name = MV_FIRST(Esql.process_parent_name_values)\n| KEEP host.name, user.name, user.id, agent.id, process.name, process.parent.executable, process.parent.name, Esql.time_window_date_trunc, Esql.*\n",
      "localized_at": "2026-09-16T01:57:06.916Z",
      "source": "linux_windows_chinese_rule.ndjson",
      "rule_id": "835c0622-114e-40b5-a346-f843ea5d01f1"
    },
